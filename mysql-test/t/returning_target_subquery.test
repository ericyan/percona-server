--echo #
--echo # RETURNING clause: subqueries in the RETURNING list that reference the
--echo # SAME table being modified by the DML statement.
--echo #
--echo # BACKGROUND: In MariaDB this was a long tail of crashes (MDEV-25028,
--echo # MDEV-25187, MDEV-28740, MDEV-27165, MDEV-29686) eventually resolved by
--echo # MDEV-32086, which outright PROHIBITS a RETURNING subquery from
--echo # referencing the table being inserted into. This test observes how our
--echo # MySQL-8.4-based implementation behaves for the analogous cases.
--echo #
--echo # CONCLUSION: MySQL's pre-existing "You can't specify target table X for
--echo # update in FROM clause" protection (ER_UPDATE_TABLE_USED) already covers
--echo # RETURNING subqueries: INSERT ... VALUES, UPDATE and DELETE all reject a
--echo # RETURNING subquery that reads the table being modified, cleanly and
--echo # without any crash (stronger than MariaDB's original behavior). Only
--echo # INSERT ... SELECT permits it, which is safe (it just buffers the result,
--echo # exactly like the classic INSERT INTO t SELECT ... FROM t). No new
--echo # prohibition or hardening was required in our implementation.
--echo #

CREATE TABLE t1 (id INT PRIMARY KEY, a INT);
CREATE TABLE t2 (id INT PRIMARY KEY, a INT);

--echo #
--echo # 1. INSERT ... VALUES ... RETURNING with a scalar subquery reading the
--echo # SAME table being inserted into.
--echo # PREDICTION: errors with ER_UPDATE_TABLE_USED. Sql_cmd_insert_base::
--echo # prepare_inner() calls setup_returning_fields() (sql/sql_base.cc), which
--echo # resolves the subquery and links its Table_ref for t1 into the global
--echo # table list (table_list->next_global), BEFORE the existing
--echo # "unique_table(lex->insert_table_leaf, table_list->next_global, true)"
--echo # duplicate-table check for the non-SELECT INSERT path (sql/sql_insert.cc,
--echo # just after setup_returning_fields()). That check is unconditional (not
--echo # RETURNING-specific) and will find the RETURNING subquery's reference to
--echo # t1 as a duplicate of the insert target, raising
--echo # update_non_unique_table_error() -> ER_UPDATE_TABLE_USED.
--echo # OBSERVED: errors with ER_UPDATE_TABLE_USED (as predicted).
--error ER_UPDATE_TABLE_USED
INSERT INTO t1 VALUES (10, 100) RETURNING id, (SELECT COUNT(*) FROM t1) AS cnt;

DELETE FROM t1;

--echo #
--echo # 2. INSERT ... SELECT ... RETURNING with a subquery referencing the
--echo # insert target table.
--echo # PREDICTION: works (no error). For the select_insert branch,
--echo # Sql_cmd_insert_base::prepare_inner() (sql/sql_insert.cc) only uses
--echo # unique_table(lex->insert_table_leaf, table_list->next_global, false) to
--echo # decide whether to add OPTION_BUFFER_RESULT (buffer the SELECT before
--echo # writing) -- it does NOT call update_non_unique_table_error() in this
--echo # branch, unlike the VALUES branch above. A RETURNING subquery reference to
--echo # t1 simply contributes to that same "duplicate found" condition, so it is
--echo # expected to just force result buffering (same as the classic
--echo # "INSERT INTO t1 SELECT * FROM t1" case), not to error.
INSERT INTO t1 VALUES (1, 1), (2, 2);
INSERT INTO t2 SELECT id + 100, a FROM t1
  RETURNING id, (SELECT COUNT(*) FROM t2) AS cnt;

DELETE FROM t1;
DELETE FROM t2;

--echo #
--echo # 3. UPDATE ... RETURNING with a NON-correlated scalar subquery reading
--echo # the SAME table being updated.
--echo # PREDICTION: works (no error), unlike DELETE/INSERT above. Sql_cmd_update
--echo # ::prepare_inner() (sql/sql_update.cc) also calls setup_returning_fields()
--echo # (before the duplicate-table check), but the UPDATE duplicate check
--echo # ("Check that tables being updated are not used in a subquery") only
--echo # calls unique_table(tr, select->leaf_tables, false) -- i.e. against the
--echo # OUTER UPDATE query block's own FROM-list, NOT the global table list.
--echo # A subquery is a separate nested Query_block whose own table reference
--echo # lives in ITS OWN leaf_tables, so it is invisible to this check. No
--echo # ER_UPDATE_TABLE_USED is expected to fire.
--echo # OBSERVED: the prediction was WRONG -- MySQL still rejects this with
--echo # ER_UPDATE_TABLE_USED. The subquery's reference to the update target is
--echo # caught by MySQL's general "can't specify target table for update in
--echo # FROM clause" protection (unique_table is also applied while resolving
--echo # subqueries against the modified table), so RETURNING inherits the same
--echo # safe rejection as a WHERE-clause self-reference. No crash, no stale rows.
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
--error ER_UPDATE_TABLE_USED
UPDATE t1 SET a = a + 1 RETURNING id, (SELECT MAX(a) FROM t1) AS mx;
SELECT * FROM t1 ORDER BY id;

DELETE FROM t1;

--echo #
--echo # 4. UPDATE ... RETURNING with a CORRELATED subquery reading the same
--echo # table (self-join style).
--echo # PREDICTION: same reasoning as case 3 (the leaf_tables-scoped duplicate
--echo # check in Sql_cmd_update::prepare_inner()/sql/sql_update.cc does not see
--echo # subquery tables), so no ER_UPDATE_TABLE_USED is expected here either.
--echo # Being correlated (re-evaluated per outer row, and it aliases the target
--echo # table as `x`), this case is the closest analogue to the MariaDB crash
--echo # reports -- watch for it also in case a crash occurs.
--echo # OBSERVED: also rejected with ER_UPDATE_TABLE_USED (no crash) -- same
--echo # protection as case 3.
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
--error ER_UPDATE_TABLE_USED
UPDATE t1 SET a = a + 1
  RETURNING id, (SELECT COUNT(*) FROM t1 x WHERE x.a < t1.a) AS cnt_less;
SELECT * FROM t1 ORDER BY id;

DELETE FROM t1;

--echo #
--echo # 5. DELETE ... RETURNING with a non-correlated scalar subquery reading
--echo # the SAME table being deleted from.
--echo # PREDICTION: errors with ER_UPDATE_TABLE_USED. Sql_cmd_delete::
--echo # prepare_inner() (sql/sql_delete.cc) calls setup_returning_fields() (which
--echo # resolves the subquery, linking its Table_ref for t1 into lex->
--echo # query_tables) BEFORE the "Check that tables being deleted from are not
--echo # used in a subquery" loop, which calls
--echo # unique_table(table_ref->updatable_base_table(), lex->query_tables,
--echo # false) -- against the FULL GLOBAL table list, unlike UPDATE. That check
--echo # is expected to find the RETURNING subquery's t1 reference as a
--echo # duplicate, raising ER_UPDATE_TABLE_USED via update_non_unique_table_error().
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
--error ER_UPDATE_TABLE_USED
DELETE FROM t1 WHERE id = 1
  RETURNING id, (SELECT COUNT(*) FROM t1) AS remaining;

DELETE FROM t1;

--echo #
--echo # 6. DELETE ... RETURNING with a correlated subquery reading the same
--echo # table.
--echo # PREDICTION: same as case 5 -- DELETE's duplicate check is against the
--echo # global table list regardless of correlation, so ER_UPDATE_TABLE_USED is
--echo # expected here too (the subquery being correlated should not change
--echo # whether its Table_ref is present in lex->query_tables).
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
--error ER_UPDATE_TABLE_USED
DELETE FROM t1 WHERE id = 1
  RETURNING id, (SELECT COUNT(*) FROM t1 x WHERE x.a < t1.a) AS cnt_less;

DELETE FROM t1;

--echo #
--echo # 7. For contrast: RETURNING subquery referencing a DIFFERENT table (t2)
--echo # works normally for all three statement types.
INSERT INTO t1 VALUES (1, 10), (2, 20);
INSERT INTO t2 VALUES (1, 100), (2, 200);

--sorted_result
INSERT INTO t1 VALUES (3, 30) RETURNING id, (SELECT COUNT(*) FROM t2) AS other_cnt;

--sorted_result
UPDATE t1 SET a = a + 1 RETURNING id, (SELECT COUNT(*) FROM t2) AS other_cnt;
SELECT * FROM t1 ORDER BY id;

--sorted_result
DELETE FROM t1 WHERE id = 1 RETURNING id, (SELECT COUNT(*) FROM t2) AS other_cnt;
SELECT * FROM t1 ORDER BY id;

DROP TABLE t1, t2;
