--echo # INSERT/REPLACE ... VALUES ... RETURNING
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, a INT, b VARCHAR(10) DEFAULT 'x');

--echo # explicit column list
INSERT INTO t1 (a) VALUES (10) RETURNING id, a, b;
--echo # RETURNING *
INSERT INTO t1 (a) VALUES (20) RETURNING *;
--echo # expression + alias
INSERT INTO t1 (a) VALUES (30) RETURNING id, a + 1 AS a_plus;
--echo # qualified wildcard
INSERT INTO t1 (a) VALUES (40) RETURNING t1.*;
--echo # multi-row VALUES: one result row per inserted row
INSERT INTO t1 (a) VALUES (50), (60), (70) RETURNING id, a;
--echo # REPLACE ... RETURNING
REPLACE INTO t1 (id, a) VALUES (1, 999) RETURNING id, a;

--echo # error: unknown column in RETURNING (resolved at prepare)
--error ER_BAD_FIELD_ERROR
INSERT INTO t1 (a) VALUES (80) RETURNING nosuchcol;

--echo # RETURNING not allowed in a stored function
delimiter |;
--error ER_SP_NO_RETSET
CREATE FUNCTION f1() RETURNS INT
BEGIN
  INSERT INTO t1 (a) VALUES (1) RETURNING id;
  RETURN 0;
END|
delimiter ;|

--echo # RETURNING not allowed in a trigger
delimiter |;
--error ER_SP_NO_RETSET
CREATE TRIGGER tr1 AFTER INSERT ON t1 FOR EACH ROW
  INSERT INTO t1 (a) VALUES (1) RETURNING id|
delimiter ;|

--echo # RETURNING allowed inside a stored procedure (returns a result set)
delimiter |;
CREATE PROCEDURE p1()
BEGIN
  INSERT INTO t1 (a) VALUES (100) RETURNING id, a;
END|
delimiter ;|
CALL p1();
DROP PROCEDURE p1;

DROP TABLE t1;

--echo # INSERT ... SELECT ... RETURNING
CREATE TABLE src (x INT);
INSERT INTO src VALUES (1), (2), (3);
CREATE TABLE t2 (id INT PRIMARY KEY AUTO_INCREMENT, x INT);
INSERT INTO t2 (x) SELECT x FROM src ORDER BY x RETURNING id, x;
--echo # RETURNING * on INSERT ... SELECT
INSERT INTO t2 (x) SELECT x + 10 FROM src ORDER BY x RETURNING *;
--echo # REPLACE ... SELECT ... RETURNING
REPLACE INTO t2 (id, x) SELECT 1, 999 RETURNING id, x;
DROP TABLE src, t2;

--echo # RETURNING with generated columns (STORED and VIRTUAL)
CREATE TABLE gc (
  id INT PRIMARY KEY AUTO_INCREMENT,
  a INT,
  b INT AS (a + 1) VIRTUAL,
  c INT AS (a * 2) STORED
);
--echo # explicit generated columns
INSERT INTO gc (a) VALUES (10) RETURNING id, a, b, c;
--echo # RETURNING * includes generated columns
INSERT INTO gc (a) VALUES (20) RETURNING *;
--echo # expression over a generated column
INSERT INTO gc (a) VALUES (30) RETURNING id, b + c AS sum_bc;
--echo # multi-row with generated columns
INSERT INTO gc (a) VALUES (40), (50) RETURNING a, b, c;
DROP TABLE gc;

--echo # INSERT IGNORE: skipped (duplicate) rows are not returned
CREATE TABLE ti (id INT PRIMARY KEY, a INT);
INSERT INTO ti VALUES (1, 100);
--echo # id=1 is a duplicate and skipped; only id=2 is inserted and returned
INSERT IGNORE INTO ti VALUES (1, 999), (2, 200) RETURNING id, a;
--echo # INSERT IGNORE ... SELECT: duplicate id=1 skipped, id=3 returned
INSERT IGNORE INTO ti SELECT 1, 111 UNION SELECT 3, 300 RETURNING id, a;
SELECT * FROM ti ORDER BY id;
DROP TABLE ti;

--echo # ON DUPLICATE KEY UPDATE ... RETURNING (final row image)
CREATE TABLE od (id INT PRIMARY KEY, a INT, cnt INT DEFAULT 0);
INSERT INTO od (id, a) VALUES (1, 10);
--echo # no duplicate: a new row is inserted; RETURNING shows the inserted row
INSERT INTO od (id, a) VALUES (2, 20)
  ON DUPLICATE KEY UPDATE a = a + 100, cnt = cnt + 1 RETURNING id, a, cnt;
--echo # duplicate id=1: the existing row is updated; RETURNING shows the updated row
INSERT INTO od (id, a) VALUES (1, 999)
  ON DUPLICATE KEY UPDATE a = a + 100, cnt = cnt + 1 RETURNING id, a, cnt;
--echo # RETURNING * with ON DUPLICATE KEY UPDATE
INSERT INTO od (id, a) VALUES (1, 999)
  ON DUPLICATE KEY UPDATE a = a + 1, cnt = cnt + 1 RETURNING *;
SELECT * FROM od ORDER BY id;
DROP TABLE od;
